<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Off: the code block runner starts python/clang/node, and Apple's
	     /usr/bin tools refuse to run inside the App Sandbox ("xcrun: cannot
	     be used within an App Sandbox"). Not an App Store app, so no sandbox.
	     The keys below only matter if the sandbox is turned back on. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Sync with the server, map tiles, Notion import -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Attach / import files the user picks, save downloads -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
